APP_NAME="AIOps Intelligence Platform"
APP_ENV=development
# Demo build: Kubernetes and the language model are simulated. Set to false only with a real cluster and Ollama.
DEMO_MODE=true
DEBUG=true
PORT=8000

# Database Configuration (PostgreSQL / TimescaleDB fallback to SQLite if PostgreSQL unavailable)
DATABASE_URL=sqlite:///./aiops.db
# DATABASE_URL=postgresql://aiops_user:aiops_password@localhost:5432/aiops_db

REDIS_URL=redis://localhost:6379/0

# Security
JWT_SECRET=super-secret-key-change-in-production-aiops-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Monitoring Endpoints
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000
LOKI_URL=http://localhost:3100
JAEGER_URL=http://localhost:16686

# SLM / AI Configuration
OLLAMA_URL=http://localhost:11434
MODEL_NAME=qwen2.5:1.5b

# Kubernetes Configuration
KUBERNETES_IN_CLUSTER=false
KUBERNETES_NAMESPACE=default
# KUBERNETES_CONFIG=~/.kube/config

# Cloud Providers (Optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
